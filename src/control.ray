// raygate — the control actor: rate limits, circuit breakers and metrics.
//
// Handler fibers must not share mutable state, so admission control and the
// metrics registry live here. A request asks Admit before calling upstream and
// Reports the outcome after. The protected call runs in the handler fiber, not
// in the breaker's owner, so instead of resilience.guard the actor drives the
// breaker with std/resilience's split is_open/report pair.
import std/time;
import std/resilience;
import net/metrics;
from config import Config, Route;

pub enum Verdict {
    Allowed,
    RateLimited,
    BreakerOpen,
}

pub enum Ctl {
    Admit(int, string, Channel<Verdict>),
    // route index, ok, latency ms, and the request's access-log line ("" = none): the actor
    // writes the lines, batched, so a request wakes one fiber fewer than with its own writer
    Report(int, bool, int, string),
    Scrape(Channel<string>),
}

struct Bucket {
    tokens: float,
    last_ms: int,
}

struct RouteState {
    route: Route,
    breaker: resilience.Breaker,
    // Rate limit POR IP (raylang M123: webserver.Request.remote): un bucket por cliente.
    // Tope defensivo: si el mapa crece demasiado (rotacion masiva de IPs) se vacia entero —
    // burdo pero acotado; los buckets renacen llenos.
    buckets: Map<string, Bucket>,
}

pub fn start(cfg: Config) -> Channel<Ctl> {
    let ch: Channel<Ctl> = Channel.bounded(256);
    spawn(fn() {
        actor_loop(ch, cfg);
    });
    ch
}

fn new_registry() -> metrics.Registry {
    let reg = metrics.registry();
    metrics.register_counter(reg, "raygate_requests_total", "requests admitted per route");
    metrics.register_counter(
        reg,
        "raygate_upstream_errors_total",
        "failed upstream calls per route"
    );
    metrics.register_counter(reg, "raygate_rate_limited_total", "requests rejected by rate limit");
    metrics.register_counter(
        reg,
        "raygate_breaker_fastfail_total",
        "requests rejected by open breaker"
    );
    metrics.register_histogram(
        reg,
        "raygate_upstream_ms",
        "upstream latency in ms",
        [5.0, 10.0, 25.0, 50.0, 100.0, 250.0, 500.0, 1000.0, 2500.0, 5000.0]
    );
    reg
}

// El bucket del cliente `ip` en la ruta (se crea LLENO la primera vez; la clave "" agrupa a
// los clientes cuyo remoto no se pudo leer). Tope defensivo de 10k IPs por ruta.
fn bucket_for(st: RouteState, ip: string) -> Bucket {
    match (get(st.buckets, ip)) {
        Option.Some(b) => b,
        Option.None => {
            if (st.buckets.keys().len() >= 10000) {
                st.buckets = Map.new();
            }
            let b = Bucket { tokens: st.route.rate_limit as float, last_ms: time.monotonic() };
            st.buckets.insert(ip, b);
            b
        },
    }
}

// Token bucket: `rate_limit` tokens/second, burst = one second's worth (min 1).
fn take_token(b: Bucket, rate: int) -> bool {
    if (rate <= 0) {
        return true;
    }
    let now_ms = time.monotonic();
    let elapsed = now_ms - b.last_ms;
    b.last_ms = now_ms;
    let cap = if (rate < 1) { 1.0 } else { rate as float };
    var tokens = b.tokens + elapsed as float * rate as float / 1000.0;
    if (tokens > cap) {
        tokens = cap;
    }
    if (tokens < 1.0) {
        b.tokens = tokens;
        return false;
    }
    b.tokens = tokens - 1.0;
    true
}

fn actor_loop(ch: Channel<Ctl>, cfg: Config) {
    var states: [RouteState] = [];
    for r in cfg.routes {
        states.push(
            RouteState {
                route: r,
                breaker: resilience.breaker(r.breaker_threshold, r.breaker_cooldown_ms),
                buckets: Map.new()
            }
        );
    }
    let reg = new_registry();
    var lines: [string] = [];
    while (true) {
        // Handle one message (waiting for it), then whatever else is already queued (up to 256),
        // then write the batch of log lines: under load they go out in large writes, and at low
        // traffic each line is written as soon as its request is reported.
        match (recv(ch)) {
            Option.None => {
                break;
            },
            Option.Some(first) => {
                handle_ctl(first, states, reg, lines);
                var n = 1;
                var more = true;
                while (more && n < 256) {
                    match (try_recv(ch)) {
                        Received.Got(m) => {
                            handle_ctl(m, states, reg, lines);
                            n = n + 1;
                        },
                        _ => {
                            more = false;
                        },
                    }
                }
                if (lines.len() > 0) {
                    print(lines.join("\n"));
                    lines = [];
                }
            },
        }
    }
}

fn handle_ctl(msg: Ctl, states: [RouteState], reg: metrics.Registry, lines: [string]) {
    match (msg) {
        Ctl.Admit(idx, ip, reply) => {
            let st = states[idx];
            let labels = metrics.labels1("route", st.route.name);
            if (resilience.is_open(st.breaker)) {
                metrics.inc(reg, "raygate_breaker_fastfail_total", labels);
                send(reply, Verdict.BreakerOpen);
            } else if (!take_token(bucket_for(st, ip), st.route.rate_limit)) {
                metrics.inc(reg, "raygate_rate_limited_total", labels);
                send(reply, Verdict.RateLimited);
            } else {
                metrics.inc(reg, "raygate_requests_total", labels);
                send(reply, Verdict.Allowed);
            }
        },
        Ctl.Report(idx, ok, latency_ms, line) => {
            if (line != "") {
                lines.push(line);
            }
            let st = states[idx];
            let labels = metrics.labels1("route", st.route.name);
            resilience.report(st.breaker, ok);
            if (!ok) {
                metrics.inc(reg, "raygate_upstream_errors_total", labels);
            }
            metrics.observe_l(reg, "raygate_upstream_ms", labels, latency_ms as float);
        },
        Ctl.Scrape(reply) => {
            send(reply, metrics.render(reg));
        },
    }
}

// Helper for handlers: one Admit round trip.
pub fn admit(ctl: Channel<Ctl>, idx: int, ip: string) -> Verdict {
    let reply: Channel<Verdict> = Channel.bounded(1);
    send(ctl, Ctl.Admit(idx, ip, reply));
    match (recv(reply)) {
        Option.Some(v) => v,
        Option.None => Verdict.Allowed,
    }
}

pub fn report(ctl: Channel<Ctl>, idx: int, ok: bool, latency_ms: int, line: string) {
    send(ctl, Ctl.Report(idx, ok, latency_ms, line));
}

pub fn scrape(ctl: Channel<Ctl>) -> string {
    let reply: Channel<string> = Channel.bounded(1);
    send(ctl, Ctl.Scrape(reply));
    match (recv(reply)) {
        Option.Some(s) => s,
        Option.None => "",
    }
}

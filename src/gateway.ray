// raygate — wiring: the request handler and the graceful server.
import std/time;
import net/webserver;
import config;
import control;
import proxy;
import accesslog;
from net/log import logger, with_trace, info, warn, field, field_int, emit;

pub struct Gate {
    cfg: config.Config,
    ctl: Channel<control.Ctl>,
    // one keep-alive pool per route, same index as cfg.routes
    pools: [Channel<proxy.UpSlot>],
    log: accesslog.AccessLog,
}

pub fn make(cfg: config.Config) -> Gate {
    var pools: [Channel<proxy.UpSlot>] = [];
    for _ in cfg.routes {
        pools.push(proxy.upstream_pool(cfg.server.upstream_pool));
    }
    let log = accesslog.start();
    Gate { cfg: cfg, ctl: control.start(cfg, log.lines), pools: pools, log: log }
}

pub fn handle(g: Gate, req: webserver.Request) -> webserver.Response {
    let t = webserver.trace_of(req);
    let lg = with_trace(logger("raygate"), t.trace_id);
    if (req.path == g.cfg.server.metrics_path && g.cfg.server.metrics_path != "") {
        var resp = webserver.text(200, control.scrape(g.ctl));
        resp.headers.insert("Content-Type", "text/plain; version=0.0.4");
        return resp;
    }
    if (req.path == g.cfg.server.health_path && g.cfg.server.health_path != "") {
        return webserver.ok("ok\n");
    }
    match (config.match_route(g.cfg.routes, req.path)) {
        Option.None => webserver.text(404, "no route\n"),
        Option.Some(idx) => {
            let route = g.cfg.routes[idx];
            match (control.admit(g.ctl, idx, webserver.remote_ip(req))) {
                control.Verdict.RateLimited => {
                    accesslog.write(g.log, field(warn(lg, "rate limited"), "route", route.name));
                    webserver.text(429, "rate limit exceeded\n")
                },
                control.Verdict.BreakerOpen => {
                    accesslog.write(g.log, field(warn(lg, "breaker open"), "route", route.name));
                    webserver.text(503, "upstream unavailable (circuit open)\n")
                },
                control.Verdict.Allowed => {
                    if (route.jwt_secret != "") {
                        match (proxy.check_jwt(req, route.jwt_secret)) {
                            Result.Err(e) => {
                                accesslog.write(
                                    g.log,
                                    field(warn(lg, "auth rejected"), "reason", e)
                                );
                                var resp = webserver.text(401, "unauthorized: " + e + "\n");
                                resp.headers.insert("WWW-Authenticate", "Bearer");
                                return resp;
                            },
                            Result.Ok(z) => { },
                        }
                    }
                    let started = time.monotonic();
                    let out = if (route.stream) {
                        proxy.streaming(req, route, t)
                    } else {
                        proxy.buffered(req, route, t, g.pools[idx])
                    };
                    let latency = time.monotonic() - started;
                    let entry = field_int(
                        field_int(
                            field(
                                field(info(lg, "proxied"), "route", route.name),
                                "method",
                                req.method
                            ),
                            "status",
                            out.response.status
                        ),
                        "ms",
                        latency
                    );
                    control.report(g.ctl, idx, out.ok, latency, accesslog.render_line(entry));
                    out.response
                },
            }
        },
    }
}

// Blocks until SIGTERM/SIGINT, then drains for drain_ms.
pub fn run(cfg: config.Config) -> Result<int, string> {
    let g = make(cfg);
    let lg = logger("raygate");
    emit(field_int(info(lg, "gateway listening"), "port", cfg.server.port));
    let r = webserver.serve_graceful(cfg.server.bind, cfg.server.port, cfg.server.drain_ms, fn(req: webserver.Request) -> webserver.Response {
        handle(g, req)
    });
    accesslog.stop(g.log);
    r
}

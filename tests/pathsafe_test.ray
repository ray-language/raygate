// The forwarded path: dot segments resolved on the decoded path, and
// re-encoded so it stays one token on the upstream request line.
import pathsafe;

@test
fn dot_segments_are_resolved() {
    assert_eq(pathsafe.normalize("/a/b/../c"), Option.Some("/a/c"));
    assert_eq(pathsafe.normalize("/public/../admin/x"), Option.Some("/admin/x"));
    assert_eq(pathsafe.normalize("/a/./b"), Option.Some("/a/b"));
    assert_eq(pathsafe.normalize("/a/b/.."), Option.Some("/a/"));
    assert_eq(pathsafe.normalize("/a/."), Option.Some("/a/"));
    assert_eq(pathsafe.normalize("/"), Option.Some("/"));
    assert_eq(pathsafe.normalize("/a//b/"), Option.Some("/a//b/"));
    assert_eq(pathsafe.normalize("/a..b/c"), Option.Some("/a..b/c"));
}

@test
fn climbing_above_the_root_or_a_relative_path_is_refused() {
    assert_eq(pathsafe.normalize("/.."), Option.None);
    assert_eq(pathsafe.normalize("/a/../../b"), Option.None);
    assert_eq(pathsafe.normalize("a/b"), Option.None);
}

@test
fn illegal_octets_are_percent_encoded() {
    assert_eq(pathsafe.encode("/a\r\nX-Extra: 1"), "/a%0D%0AX-Extra:%201");
    assert_eq(pathsafe.encode("/100%/a?b#c"), "/100%25/a%3Fb%23c");
    assert_eq(pathsafe.encode("/ñ"), "/%C3%B1");
}

@test
fn a_legal_path_is_left_as_is() {
    assert_eq(pathsafe.encode("/v1/users/42;x=1/@me:a,b+c"), "/v1/users/42;x=1/@me:a,b+c");
}
